{
  "name": "stillwater-counselling-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.mjs",
    "preview": "sirv build/client --single __spa-fallback.html --port 4173",
    "images": "python3 scripts/make_images.py && node scripts/images.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:built": "node scripts/name-guard.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@react-router/node": "^8.5.0",
    "gsap": "^3.15.0",
    "isbot": "^5.2.2",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "sirv-cli": "^3.0.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
